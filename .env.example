# BuildHub Docker environment (copy to .env and adjust)
# Final host port map: see PORTS.md
#
# Do not commit real secrets. Replace placeholders below.

# Optional: override Google OAuth (otherwise auth-server uses config/application-local.yml)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# RabbitMQ credentials (required — set in local .env; never commit real passwords)
RABBITMQ_USERNAME=your-rabbitmq-username
RABBITMQ_PASSWORD=your-rabbitmq-password
RABBITMQ_VHOST=/

# Downstream API keys injected by API Gateway (override in local .env for production)
SUPPLIER_API_KEY=buildmate-supplier-key
MATERIAL_API_KEY=buildmate-material-key
PAYMENT_API_KEY=buildmate-payment-key
ORDER_API_KEY=buildmate-order-key
